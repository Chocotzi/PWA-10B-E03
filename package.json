{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/starter.spec.mjs && vitest run --coverage",
    "test:unit": "vitest run tests/unit --outputFile.junit=test-results/unit.xml",
    "test:integration": "vitest run tests/integration --outputFile.junit=test-results/integration.xml",
    "test:e2e": "vitest run tests/e2e --outputFile.junit=test-results/e2e.xml",
    "test:e2e:browser": "playwright test",
    "measure:rendering": "node scripts/measure-rendering.mjs",
    "check:capabilities-browser": "node scripts/check-capabilities-browser.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
